PORT=3000
DB_PATH=./data/game.db

# Serviço de IA compatível com a API OpenAI (LM Studio, Ollama, OpenAI, etc.)
# LM Studio: inicie o "Local Server" na aba Developer e use http://localhost:1234/v1
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=local-model
# LM Studio aceita qualquer valor; OpenAI exige a chave real (sk-...)
OPENAI_API_KEY=lm-studio
